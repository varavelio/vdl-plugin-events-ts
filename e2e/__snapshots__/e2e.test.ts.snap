"// Generated by VDL. Do not edit.

/**
 * Builds the subject for the ComplexPayloadEvent event.
 *
 * Subject: audit.{tenantId}.payload.created
 */
export function buildComplexPayloadEventSubject(tenantId: string): string {
  return \`audit.\${tenantId}.payload.created\`;
}

/**
 * Metadata for a single VDL event.
 */
// biome-ignore lint/suspicious/noExplicitAny: generated builder arity varies per event.
export interface VDLEventMetadata<TBuildSubject extends (...args: any[]) => string> {
  /** Event payload type name. */
  name: string;
  /** Literal subject template from the \`@event\` annotation. */
  subjectTemplate: string;
  /** Typed subject builder for this event. */
  buildSubject: TBuildSubject;
}

/**
 * Catalogs all \`@event\`-annotated types with their subject metadata and builders.
 */
export interface VDLEventCatalog {
  /**
   * Metadata for the ComplexPayloadEvent event.
   *
   * Subject: audit.{tenantId}.payload.created
   */
  ComplexPayloadEvent: VDLEventMetadata<(tenantId: string) => string>;
}

/**
 * Indexes generated events by payload type name.
 */
export const VDLEvents: VDLEventCatalog = {
  /**
   * Metadata for the ComplexPayloadEvent event.
   *
   * Subject: audit.{tenantId}.payload.created
   */
  ComplexPayloadEvent: {
    name: "ComplexPayloadEvent",
    subjectTemplate: "audit.{tenantId}.payload.created",
    buildSubject: buildComplexPayloadEventSubject,
  },
};"
`;

