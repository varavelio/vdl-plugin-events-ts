"// Generated by VDL. Do not edit.

/**
 * Catalogs all \`@event\`-annotated types with their subject metadata and builders.
 */
export interface VDLEventCatalog {
  /**
   * Metadata for the PrimitiveSubjectEvent event.
   *
   * Subject: metrics.{name}.{count}.{amount}.{active}.{occurredAt}
   */
  PrimitiveSubjectEvent: {
    /** Event payload type name. */
    name: string;
    /** Literal subject template from the \`@event\` annotation. */
    subjectTemplate: string;
    /** Typed subject builder for this event. */
    buildSubject: (name: string, count: number, amount: number, active: boolean, occurredAt: Date) => string;
  };
}

/**
 * Indexes generated events by payload type name.
 */
export const VDLEvents: VDLEventCatalog = {
  /**
   * Metadata for the PrimitiveSubjectEvent event.
   *
   * Subject: metrics.{name}.{count}.{amount}.{active}.{occurredAt}
   */
  PrimitiveSubjectEvent: {
    /** Event payload type name. */
    name: "PrimitiveSubjectEvent",
    /** Literal subject template from the \`@event\` annotation. */
    subjectTemplate: "metrics.{name}.{count}.{amount}.{active}.{occurredAt}",
    /** Typed subject builder for this event. */
    buildSubject(name: string, count: number, amount: number, active: boolean, occurredAt: Date): string {
      return \`metrics.\${name}.\${count}.\${amount}.\${active}.\${occurredAt.toISOString()}\`;
    },
  },
};"
`;

